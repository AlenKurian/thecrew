# Email — application submissions are emailed via Gmail SMTP (no database).
#
# 1. Use a Gmail account with 2-Step Verification turned ON.
# 2. Create an App Password: https://myaccount.google.com/apppasswords
#    (pick "Mail" / "Other" — you'll get a 16-character password).
# 3. Put that App Password below — NOT your normal Google password.

GMAIL_USER=youraccount@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Optional — where applications are delivered. Defaults to GMAIL_USER.
STUDIO_WYTES_NOTIFY_EMAIL=team@studiowytes.com
