# Email — application submissions are sent over SMTP (no database).
# Works with Zoho, Gmail, Outlook, or any SMTP provider.
#
# Zoho Mail (Hello@wytes.studio):
#   SMTP_HOST = smtp.zoho.com   (use smtp.zoho.in or smtp.zoho.eu if the
#               account was created in the India / EU data center)
#   SMTP_PORT = 465
#   SMTP_USER = Hello@wytes.studio
#   SMTP_PASS = the mailbox password, OR an app-specific password if the
#               Zoho account has Two-Factor Auth on
#               (Zoho Mail -> Settings -> Security -> App Passwords)

SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=Hello@wytes.studio
SMTP_PASS=your-mailbox-or-app-password

# Optional — the visible From address. Defaults to SMTP_USER.
MAIL_FROM=Hello@wytes.studio

# Where application details are delivered. Defaults to SMTP_USER.
STUDIO_WYTES_NOTIFY_EMAIL=Hello@wytes.studio
