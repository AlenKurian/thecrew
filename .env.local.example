# Supabase
# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — NEVER expose this to the client.
# Used exclusively inside app/api/applications/route.ts (server-side).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email (optional — wire up when ready)
# https://resend.com
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=crew@studiowytes.com
STUDIO_WYTES_NOTIFY_EMAIL=team@studiowytes.com
